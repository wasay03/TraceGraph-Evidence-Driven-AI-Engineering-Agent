TG_DATABASE_URL=postgresql+psycopg://tg:tg@localhost:5432/tracegraph
TG_API_KEY=change-me
TG_LOG_LEVEL=INFO
TG_WORKSPACE_DIR=/tmp/tracegraph/worktrees

# Agent LLM: provider (anthropic | gemini), model id, and API key.
# Without TG_LLM_API_KEY the provider SDK reads its own variable (GEMINI_API_KEY / GOOGLE_API_KEY, ANTHROPIC_API_KEY).
TG_LLM_PROVIDER=gemini
TG_LLM_MODEL=gemini-2.5-pro
TG_LLM_API_KEY=
TG_LLM_MAX_OUTPUT_TOKENS=16000
